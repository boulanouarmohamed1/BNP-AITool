# Docker image name to use locally and when publishing to Docker Hub.
DOCKER_IMAGE=your-dockerhub-username/bnp-cha:latest

# Ports exposed on the host.
APP_PORT=8501
OLLAMA_PORT=11434

# Models downloaded at first start and used by the application.
SEMANTIC_VERIFIER_MODEL=qwen2.5:3b
RAG_EMBEDDING_MODEL=BAAI/bge-m3
